APP_NAME=SITANGKAS
APP_ENV=local
APP_KEY=
# Production must set AUDIT_HASH_KEY to a random secret different from APP_KEY.
AUDIT_HASH_KEY=
APP_VERSION=
APP_BUILD_NUMBER=
APP_BUILD_COMMIT=
APP_DEBUG=false
APP_URL=http://localhost
TRUSTED_PROXIES=

RECAPTCHAV3_SITEKEY=
RECAPTCHAV3_SECRET=
RECAPTCHAV3_ORIGIN=https://www.google.com/recaptcha
RECAPTCHAV3_LOCALE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_REMEMBER_ME_ENABLED=true
AUTH_REMEMBER_ME_DURATION_MINUTES=1440
AUTH_REMEMBER_ME_SINGLE_DEVICE=true
AUTH_REMEMBER_ME_ADMIN_SUPER_ALLOWED=false
AUTH_REMEMBER_ME_RESTORE_NON_ADMIN_CONTEXT=true

MFA_ENABLED=true
MFA_METHOD=totp
MFA_ADMIN_SUPER_REQUIRED=true
MFA_ADMIN_SUPER_VERIFIED_TTL_MINUTES=30
MFA_ADMIN_SUPER_ALLOW_TRUSTED_DEVICE=false
MFA_NON_ADMIN_AVAILABLE=true
MFA_NON_ADMIN_REQUIRED=false
MFA_NON_ADMIN_ENFORCE_WHEN_ENABLED=true
MFA_NON_ADMIN_VERIFIED_TTL_MINUTES=30
MFA_NON_ADMIN_ALLOW_TRUSTED_DEVICE=true
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_WINDOW=1
MFA_RECOVERY_CODE_COUNT=8

AUTH_LOGIN_EVENT_USER_AGENT_ENRICHMENT_ENABLED=true
AUTH_LOGIN_EVENT_USER_AGENT_PROVIDER=matomo_device_detector
AUTH_LOGIN_EVENT_FORWARDED_FOR_MAX_ENTRIES=10
AUTH_LOGIN_EVENT_CAPTURE_UNTRUSTED_FORWARDED_FOR=false
AUTH_LOGIN_EVENT_PROXY_IP_ADDRESS_ENABLED=true
AUTH_LOGIN_EVENT_GEOIP_ENABLED=false
AUTH_LOGIN_EVENT_GEOIP_PROVIDER=maxmind
AUTH_LOGIN_EVENT_GEOIP_DATABASE_PATH=
AUTH_LOGIN_EVENT_GEOIP_CITY_DATABASE_PATH=
AUTH_LOGIN_EVENT_GEOIP_ASN_DATABASE_PATH=
AUTH_LOGIN_EVENT_GEOIP_CACHE_TTL_SECONDS=86400
AUTH_LOGIN_EVENT_IP_RISK_ENABLED=false
AUTH_LOGIN_EVENT_IP_RISK_MODE=audit
AUTH_LOGIN_EVENT_IP_RISK_BLOCKING_ENABLED=false
AUTH_LOGIN_EVENT_IP_RISK_PROVIDER=none
AUTH_LOGIN_EVENT_IP_RISK_ANONYMOUS_IP_DATABASE_PATH=
AUTH_LOGIN_EVENT_IP_RISK_ALLOWLIST_CIDRS=
AUTH_LOGIN_EVENT_IP_RISK_TIMEOUT_SECONDS=2
AUTH_LOGIN_EVENT_IP_RISK_CONNECT_TIMEOUT_SECONDS=1
AUTH_LOGIN_EVENT_IP_RISK_CACHE_TTL_SECONDS=86400
AUTH_LOGIN_EVENT_CLIENT_TIMEZONE_ENABLED=true
AUTH_LOGIN_EVENT_DEVICE_FINGERPRINT_ENABLED=false
AUTH_LOGIN_EVENT_DEVICE_FINGERPRINT_STRATEGY=first_party_device_token
AUTH_LOGIN_EVENT_HASH_ENABLED=true
AUTH_LOGIN_EVENT_RETENTION_DAYS=

SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_CSP_ENABLED=true
SECURITY_HEADERS_CSP_REPORT_ONLY=false
SECURITY_HEADERS_HSTS_ENABLED=false
SECURITY_HEADERS_HSTS_PRELOAD=false

# BSrE eSign Client 2.2.0. Disabled by default and validated when enabled.
# Credentials must come from the deployment secret store and never use VITE_* variables.
BSRE_ESIGN_ENABLED=false
BSRE_ESIGN_BASE_URL=
BSRE_ESIGN_USERNAME=
BSRE_ESIGN_PASSWORD=
BSRE_ESIGN_VERIFY_TLS=true
BSRE_ESIGN_ALLOW_INSECURE_HTTP=false
BSRE_ESIGN_CONNECT_TIMEOUT=10
BSRE_ESIGN_VERIFY_CONNECT_TIMEOUT=5
BSRE_ESIGN_STATUS_TIMEOUT=30
BSRE_ESIGN_TOTP_TIMEOUT=30
BSRE_ESIGN_CERTIFICATE_TIMEOUT=30
BSRE_ESIGN_SIGN_TIMEOUT=30
BSRE_ESIGN_VERIFY_TIMEOUT=120
BSRE_ESIGN_LOCATION="Pemerintah Kota Malang"
BSRE_ESIGN_DEFAULT_REASON="Dokumen telah disetujui dan ditandatangani secara elektronik"
BSRE_ESIGN_SIGN_ENDPOINT=/api/v2/sign/pdf
BSRE_ESIGN_VERIFY_ENDPOINT=/api/v2/verify/pdf
BSRE_ESIGN_USER_STATUS_ENDPOINT=/api/v2/user/check/status
BSRE_ESIGN_TOTP_ENDPOINT=/api/v2/sign/get/totp
BSRE_ESIGN_CERTIFICATE_CHAIN_ENDPOINT=/api/v2/user/certificate/chain
ESIGN_ARTIFACT_DISK=private
ESIGN_ARTIFACT_ROOT=documents
ESIGN_ARTIFACT_TIMEZONE=Asia/Jakarta
ESIGN_SIGNING_SESSION_CACHE_STORE=
ESIGN_SIGNING_SESSION_TTL_MINUTES=15
SIGNATURE_FRONTEND_ENABLED=false
SIGNATURE_VERIFICATION_CACHE_STORE=
SIGNATURE_VERIFICATION_CACHE_TTL_MINUTES=60
SIGNATURE_PREPARED_DISK=private
SIGNATURE_PREPARED_ROOT=esign-prepared
SIGNATURE_PREPARED_RETENTION_MINUTES=120
SIGNATURE_PDFINFO_BINARY=pdfinfo
SIGNATURE_QPDF_BINARY=qpdf
SIGNATURE_PDF_RENDER_TIMEOUT_SECONDS=120
SIGNATURE_VERIFY_BASE_URL=https://sitangkas.malangkota.go.id/verify
SIGNATURE_EDITOR_MAX_PAGES=500
SIGNATURE_EDITOR_MAX_OPERATIONS=5
SIGNATURE_EDITOR_SAFE_MARGIN_PT=18
SIGNATURE_EDITOR_MINIMUM_GAP_PT=6
SIGNATURE_EDITOR_QR_MINIMUM_SIZE_PT=54
SIGNATURE_EDITOR_QR_MAXIMUM_SIZE_PT=180
SIGNATURE_EDITOR_QR_IMAGE_SIZE_PIXELS=300
SIGNATURE_EDITOR_QR_IMAGE_MARGIN_PIXELS=12
SIGNATURE_EDITOR_FOOTER_HEIGHT_PT=32
SIGNATURE_EDITOR_FOOTER_TEXT="Dokumen ini telah ditandatangani secara elektronik menggunakan sertifikat elektronik."
SIGNATURE_MULTI_OPERATION_ENABLED=false
SIGNATURE_QUEUE_CONNECTION=signatures
SIGNATURE_QUEUE=signatures
SIGNATURE_QUEUE_RETRY_AFTER_SECONDS=960
SIGNATURE_JOB_TIMEOUT_SECONDS=900
SIGNATURE_PROVISIONING_JOB_TIMEOUT_SECONDS=180
SIGNATURE_SECRET_CACHE_STORE=
SIGNATURE_ASYNC_SECRET_TTL_MINUTES=30
SIGNATURE_MAX_FILE_SIZE_MB=50
SIGNATURE_CONTRACT_PROOF_ENABLED=false
SIGNATURE_CONTRACT_PROOF_DISK=private
SIGNATURE_CONTRACT_PROOF_ROOT=esign-contract-proofs
SIGNATURE_CONTRACT_PROOF_VERIFY_BASE_URL=https://sitangkas.malangkota.go.id/verify
SIGNATURE_CONTRACT_PROOF_MAX_OPERATIONS=5
SIGNATURE_CONTRACT_PROOF_QR_SIZE_PIXELS=300
SIGNATURE_CONTRACT_PROOF_QR_MARGIN_PIXELS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=sitangkas_legacy
LEGACY_DB_USERNAME=legacy_reader
LEGACY_DB_PASSWORD=

# Local development only. Never enable this override in shared or production environments.
LEGACY_IMPORT_DEV_SHARED_PASSWORD_ENABLED=false
LEGACY_IMPORT_DEV_SHARED_PASSWORD=
LEGACY_IMPORT_DEV_FORCE_PASSWORD_CHANGE=false
LEGACY_IMPORT_SK_SOURCE_DIRECTORY=
LEGACY_IMPORT_PDFINFO_BINARY=pdfinfo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
