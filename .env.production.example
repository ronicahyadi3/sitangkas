APP_NAME=SITANGKAS
APP_ENV=production
APP_KEY=
AUDIT_HASH_KEY=
APP_DEBUG=false
APP_URL=https://sitangkas.example.go.id

RECAPTCHAV3_SITEKEY=
RECAPTCHAV3_SECRET=
RECAPTCHAV3_ORIGIN=https://www.google.com/recaptcha
RECAPTCHAV3_LOCALE=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

AUTH_REMEMBER_ME_ENABLED=true
AUTH_REMEMBER_ME_DURATION_MINUTES=1440
AUTH_REMEMBER_ME_SINGLE_DEVICE=true
AUTH_REMEMBER_ME_ADMIN_SUPER_ALLOWED=false
AUTH_REMEMBER_ME_RESTORE_NON_ADMIN_CONTEXT=true

MFA_ENABLED=true
MFA_METHOD=totp
MFA_ADMIN_SUPER_REQUIRED=true
MFA_ADMIN_SUPER_VERIFIED_TTL_MINUTES=30
MFA_ADMIN_SUPER_ALLOW_TRUSTED_DEVICE=false
MFA_NON_ADMIN_AVAILABLE=true
MFA_NON_ADMIN_REQUIRED=false
MFA_NON_ADMIN_ENFORCE_WHEN_ENABLED=true
MFA_NON_ADMIN_VERIFIED_TTL_MINUTES=30
MFA_NON_ADMIN_ALLOW_TRUSTED_DEVICE=true
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_WINDOW=1
MFA_RECOVERY_CODE_COUNT=8

SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_CSP_ENABLED=true
SECURITY_HEADERS_CSP_REPORT_ONLY=false
SECURITY_HEADERS_HSTS_ENABLED=true
SECURITY_HEADERS_HSTS_PRELOAD=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitangkas
DB_USERNAME=sitangkas
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=sitangkas

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@sitangkas.example.go.id
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
